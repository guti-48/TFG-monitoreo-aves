# Servidor central visto desde la Raspberry Pi.
BIRDMONITOR_SERVER_URL=http://IP_DEL_SERVIDOR:8000

# Identidad y ubicacion de este nodo.
BIRDMONITOR_NODE_NAME=birdmonitor-01
BIRDMONITOR_NODE_LOCATION=Sevilla
BIRDMONITOR_NODE_LAT=37.3891
BIRDMONITOR_NODE_LON=-5.9845
BIRDMONITOR_AUTO_GEOLOCATION=0

# Captura y deteccion.
BIRDMONITOR_MIC_DEVICE=
BIRDMONITOR_RECORD_SECONDS=60
BIRDMONITOR_RECORD_INTERVAL_SECONDS=300
BIRDMONITOR_BIRD_CONFIDENCE_THRESHOLD=0.65
BIRDMONITOR_HUMAN_CONFIDENCE_THRESHOLD=0.35
BIRDMONITOR_MOTOR_CONFIDENCE_THRESHOLD=0.40
BIRDMONITOR_HIGH_NOISE_RMS_THRESHOLD=0.02
BIRDMONITOR_RETENTION_DAYS=9

# BirdWeather es opcional. Mantener desactivado hasta configurar el token.
BIRDWEATHER_ENABLED=0
BIRDWEATHER_TOKEN_FILE=/etc/birdmonitor/birdweather_token

# Servicio que publica el audio en directo.
BIRDMONITOR_STREAM_SERVICE=birdstream.service
BIRDMONITOR_STREAM_POLL_INTERVAL=5
