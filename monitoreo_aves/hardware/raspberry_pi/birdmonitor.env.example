# Servidor central visto desde la Raspberry Pi.
BIRDMONITOR_NETWORK_MODE=local
BIRDMONITOR_SERVER_URL=http://IP_DEL_SERVIDOR:8000
# Token mostrado una sola vez por scripts/configure_security.py en el servidor.
BIRDMONITOR_NODE_API_TOKEN=PEGA_AQUI_EL_TOKEN_GENERADO

# Identidad del hardware.
BIRDMONITOR_NODE_NAME=birdmonitor-01

# Sitio estable y campaña activa. El UUID se genera una sola vez al instalar o
# mover el nodo; los reinicios deben conservarlo.
BIRDMONITOR_SITE_CODE=sevilla
BIRDMONITOR_SITE_NAME=Sevilla - ubicacion principal
BIRDMONITOR_SITE_MUNICIPALITY=Sevilla
BIRDMONITOR_SITE_REGION=Andalucia
BIRDMONITOR_SITE_COUNTRY_CODE=ES
BIRDMONITOR_SITE_TIMEZONE=Europe/Madrid
BIRDMONITOR_SITE_LOCATION_SOURCE=manual
BIRDMONITOR_SITE_LOCATION_ACCURACY_M=10
BIRDMONITOR_DEPLOYMENT_ID=PEGA_AQUI_UN_UUID
BIRDMONITOR_DEPLOYMENT_STARTED_AT=2026-08-23T12:00:00+00:00
BIRDMONITOR_DEPLOYMENT_NOTES=Instalacion inicial
# Estado operativo generado por los cambios confirmados desde el dashboard.
# Debe ser escribible por el usuario de birdmonitor.service y no se versiona.
BIRDMONITOR_DEPLOYMENT_STATE_FILE=/home/pi/birdmonitor/monitoreo_aves/hardware/raspberry_pi/deployment_state.json

# Identidad historica usada exclusivamente para etiquetar elementos de la cola
# creados antes de esta migracion. No son credenciales.
BIRDMONITOR_LEGACY_SITE_CODE=sevilla
BIRDMONITOR_LEGACY_DEPLOYMENT_ID=PEGA_AQUI_EL_UUID_HISTORICO_DEL_SERVIDOR

# Coordenadas que comparten el sitio, BirdNET y BirdWeather.
BIRDMONITOR_NODE_LOCATION=Sevilla
BIRDMONITOR_NODE_LAT=37.3891
BIRDMONITOR_NODE_LON=-5.9845
BIRDMONITOR_AUTO_GEOLOCATION=0

# Captura y deteccion.
BIRDMONITOR_MIC_DEVICE=
# Opcional en Linux: ganancia fisica fija del microfono ALSA.
BIRDMONITOR_MIC_ALSA_CARD=
BIRDMONITOR_MIC_CAPTURE_VOLUME=
BIRDMONITOR_MIC_AUTO_GAIN=
BIRDMONITOR_RECORD_SECONDS=60
BIRDMONITOR_RECORD_INTERVAL_SECONDS=300
BIRDMONITOR_BIRD_CONFIDENCE_THRESHOLD=0.65
BIRDMONITOR_HUMAN_CONFIDENCE_THRESHOLD=0.35
BIRDMONITOR_MOTOR_CONFIDENCE_THRESHOLD=0.40
BIRDMONITOR_HIGH_NOISE_RMS_THRESHOLD=0.02
# Motor reproducible y diagnostico del microfono. Normalmente no hace falta cambiarlos.
BIRDMONITOR_BIRDNET_MODEL_VERSION=2.4
BIRDMONITOR_BIRDNET_OVERLAP_SECONDS=1.5
BIRDMONITOR_BIRDNET_SENSITIVITY=1.25
BIRDMONITOR_MIC_MIN_RMS=0.001
BIRDMONITOR_MIC_MAX_CLIPPING_RATIO=0.001
BIRDMONITOR_MIC_MAX_DC_OFFSET=0.02
BIRDMONITOR_MIC_CLIPPING_LEVEL=0.99
BIRDMONITOR_RETENTION_DAYS=9

# BirdWeather es opcional. Mantener desactivado hasta configurar el token.
BIRDWEATHER_ENABLED=0
BIRDWEATHER_TOKEN_FILE=/etc/birdmonitor/birdweather_token
# Normalmente no se cambia. {token} se sustituye de forma segura en tiempo de ejecucion.
BIRDWEATHER_URL=https://app.birdweather.com/api/v1/stations/{token}/detections

# Servicio que publica el audio en directo.
BIRDMONITOR_STREAM_SERVICE=birdstream.service
BIRDMONITOR_STREAM_POLL_INTERVAL=5
BIRDMONITOR_STREAM_FAILURE_LIMIT=3
BIRDMONITOR_STREAM_HEALTH_TIMEOUT=5
