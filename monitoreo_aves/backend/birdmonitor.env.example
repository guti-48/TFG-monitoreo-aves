# La configuracion real se genera con:
# python scripts/configure_security.py
BIRDMONITOR_SECURITY_MODE=required
BIRDMONITOR_ADMIN_USERNAME=admin
BIRDMONITOR_ADMIN_PASSWORD_HASH=scrypt$VALOR_GENERADO
BIRDMONITOR_NODE_TOKEN_HASH=sha256$VALOR_GENERADO
BIRDMONITOR_SESSION_SECRET=VALOR_ALEATORIO_GENERADO
BIRDMONITOR_SESSION_HOURS=12

# Usar 1 solo cuando el dashboard se sirva mediante HTTPS.
BIRDMONITOR_COOKIE_SECURE=0

# Elegir explicitamente con scripts/configure_network_mode.py.
BIRDMONITOR_NETWORK_MODE=local
BIRDMONITOR_SERVER_HOST=192.168.1.10
BIRDMONITOR_BACKEND_HOST=0.0.0.0
BIRDMONITOR_BACKEND_PORT=8000
BIRDMONITOR_CORS_ORIGINS=http://192.168.1.10:8000,http://127.0.0.1:8000,http://localhost:8000
BIRDMONITOR_STREAM_RTSP_BASE_URL=rtsp://192.168.1.10:8554

# La configuracion real se genera con:
# python scripts/configure_stream_security.py --server-host IP_DEL_SERVIDOR
BIRDMONITOR_STREAM_SECURITY_MODE=required
BIRDMONITOR_STREAM_PUBLISH_USER=birdmonitor-publisher
BIRDMONITOR_STREAM_PUBLISH_PASSWORD_HASH=sha256$VALOR_GENERADO
BIRDMONITOR_STREAM_READER_USER=birdmonitor-viewer
BIRDMONITOR_STREAM_READER_PASSWORD=VALOR_ALEATORIO_GENERADO
BIRDMONITOR_STREAM_PROXY_USER=birdmonitor-backend
BIRDMONITOR_STREAM_PROXY_PASSWORD=VALOR_ALEATORIO_GENERADO
BIRDMONITOR_MEDIAMTX_HLS_INTERNAL_URL=http://127.0.0.1:8888